# ──────────────────────────────────────────────────────────────────────────
# PepeTrip — BACKEND / SERVER environment
# Copy this file to `backend/.env` and fill it in.
# The API validates these at boot with Zod and refuses to start if a REQUIRED
# var is missing or invalid. Frontend (Vite) vars live in frontend/.env.example.
#
# Tip: for a zero-setup local run you don't even need this file —
#   `npm run dev:mem`  starts an in-memory MongoDB + demo login automatically.
# This file is for `npm run dev` (real MongoDB) and for production reference.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated allowed browser origins. Dev only (Vite on :5173);
# in production the app is same-origin so this can stay empty.
CORS_ORIGINS=http://localhost:5173

# ── Database (REQUIRED) ───────────────────────────────────────────────────
# Local default below; use a free MongoDB Atlas M0 connection string in prod.
MONGODB_URI=mongodb://localhost:27017/pepetrip

# ── Auth / JWT (secrets REQUIRED, min 16 chars) ───────────────────────────
# Generate strong values, e.g.:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Set true in production (HTTPS) so the refresh cookie is Secure.
COOKIE_SECURE=false

# ── Dev-only demo login ───────────────────────────────────────────────────
# Enables POST /api/v1/auth/dev-login + the "Try the demo" button.
# Hard-disabled when NODE_ENV=production regardless of this value. Keep false in prod.
ALLOW_DEV_LOGIN=false

# ── Google sign-in ────────────────────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
# The frontend reads this from the API's /config endpoint (no VITE copy needed).
GOOGLE_CLIENT_ID=

# ── AI provider (Gemini free tier: https://aistudio.google.com/apikey) ────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── File storage (photos / documents) ────────────────────────────────────
# 'local' writes to UPLOAD_DIR and serves it at /uploads — fine for dev, but
# EPHEMERAL on Render's free tier (uploads vanish on redeploy). For durable
# storage set STORAGE_DRIVER=cloudinary and CLOUDINARY_URL (free tier).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_URL=

# ── Gated integrations (Phase 4) — OFF by default ─────────────────────────
# Each needs paid API access and/or Google verification before it does anything.
FEATURE_GMAIL=false
FEATURE_GOOGLE_PHOTOS=false
FEATURE_PRICE_TRACKING=false
