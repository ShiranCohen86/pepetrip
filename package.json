{
  "name": "pepetrip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PepeTrip — AI-powered travel platform (planner, memories, expenses, maps, docs/OCR, admin)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:mem": "concurrently -n api,web -c blue,green \"npm -w @pepetrip/api run dev:mem\" \"npm:dev:web\"",
    "dev:api": "npm -w @pepetrip/api run dev",
    "dev:web": "npm -w @pepetrip/web run dev",
    "build": "npm -w @pepetrip/web run build && node scripts/copy-client.js",
    "start": "node backend/src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm -w @pepetrip/shared run test --if-present && npm -w @pepetrip/api run test --if-present && npm -w @pepetrip/web run test --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
